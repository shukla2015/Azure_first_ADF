{
	"name": "sourcetotarget",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "salesourcetemp",
						"type": "DatasetReference"
					},
					"name": "sourcesales"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "salestargettemp",
						"type": "DatasetReference"
					},
					"name": "yearwisemonthlysales",
					"rejectedDataLinkedService": {
						"referenceName": "AzureBlobStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "filtersalesabove2000"
				},
				{
					"name": "aggregateyearmonthbasis"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ORDERNUMBER as short,",
				"          QUANTITYORDERED as short,",
				"          PRICEEACH as double,",
				"          ORDERLINENUMBER as short,",
				"          SALES as double,",
				"          ORDERDATE as timestamp,",
				"          STATUS as string,",
				"          QTR_ID as short,",
				"          MONTH_ID as short,",
				"          YEAR_ID as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sourcesales",
				"sourcesales filter(SALES>=2000) ~> filtersalesabove2000",
				"filtersalesabove2000 aggregate(groupBy(YEAR = YEAR_ID,",
				"          MONTH = MONTH_ID),",
				"     TOTALSALES = sum(SALES)) ~> aggregateyearmonthbasis",
				"aggregateyearmonthbasis sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> yearwisemonthlysales"
			]
		}
	}
}